# =============================================================================
# .gitignore — Chandrayaan-2 Lunar Image Registration
# =============================================================================

# --- Byte-compiled / Python caches ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyd
*.pyo

# --- Virtual Environments ---
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Environment & Secret Variables ---
.env
.env.*
!.env.example

# --- Python Tools & Test Caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.log

# --- Node / Next.js Frontend ---
node_modules/
lunar-frontend/node_modules/
.next/
lunar-frontend/.next/
out/
lunar-frontend/out/
*.tsbuildinfo
lunar-frontend/tsconfig.tsbuildinfo
.npm/

# --- Operating System & Editor ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
tempCodeRunnerFile.py

# =============================================================================
# PIPELINE OUTPUTS (Strictly ignored so users must run the pipeline to generate)
# =============================================================================

# Main pipeline execution outputs (generated by run_demo.py)
results/*
!results/.gitkeep

# Registration and benchmark output artifacts
registration_output/
registration_output_demo/
benchmarks/registration_benchmark_output/
benchmarks/large_iirs_benchmark_output/
evaluation_output/
reports/
eval_results/
per_pair/

# Match points generated by pipeline runs
data_preprocessing_pipeline/matches/
*/matches/

# Intermediate and dynamic registration outputs
**/registration_out/
data_preprocessing_pipeline/dynamic_runs/
data_preprocessing_pipeline/.uploads/
data_preprocessing_pipeline/processed_triplets/region_auto_*/
data_preprocessing_pipeline/lro_nac_pairs/
data_preprocessing_pipeline/demo_regions_backup/

# Frontend pre-rendered registered images (generated outputs)
lunar-frontend/public/images/registered/*
!lunar-frontend/public/images/registered/.gitkeep

# Temporary / Scratch Test Directories
temp_test/
scratch/
test_output/
tiled_output/
dynamic_runs/

# Backend local database and session storage
backend/data/users.json
backend/data/jobs.json

# Large raw raster caches (preserve sample inputs in sample_data/)
data/raw/
data/pyramids/
tiles/
output/
outputs/
*.geojson.cache

# Model checkpoints (preserve inference weight ai_verifier_model.pkl)
*.ckpt
weights/
